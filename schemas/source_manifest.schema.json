{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned paper sources",
  "type": "object",
  "required": ["schema_version", "paper_id", "title", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "paper_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "locator"],
        "properties": {
          "kind": {"type": "string"},
          "locator": {"type": "string"},
          "revision": {"type": "string"},
          "sha256": {"type": "string"}
        }
      }
    }
  }
}
