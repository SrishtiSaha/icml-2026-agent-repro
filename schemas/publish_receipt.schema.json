{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verified public publication",
  "type": "object",
  "required": ["schema_version", "report_hash", "url", "public_revision", "public_content_sha256", "validation_report_hash", "public_verified", "published_at"],
  "properties": {
    "schema_version": {"const": 1},
    "report_hash": {"type": "string"},
    "url": {"type": "string"},
    "public_revision": {"type": "string"},
    "public_content_sha256": {"type": "string"},
    "validation_report_hash": {"type": "string"},
    "public_verified": {"const": true},
    "published_at": {"type": "string"}
  }
}
