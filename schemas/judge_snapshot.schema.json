{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Judge verdict tied to a publication",
  "type": "object",
  "required": ["schema_version", "publish_hash", "judged_at", "claims"],
  "properties": {
    "schema_version": {"const": 1},
    "publish_hash": {"type": "string"},
    "judged_at": {"type": "string"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "verdict"],
        "properties": {
          "id": {"type": "string"},
          "verdict": {"enum": ["verified", "falsified", "toy", "inconclusive"]},
          "feedback": {"type": "string"}
        }
      }
    }
  }
}
